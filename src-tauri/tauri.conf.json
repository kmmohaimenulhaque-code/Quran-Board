{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quran Instrument",
  "version": "1.0.0",
  "identifier": "com.quran.instrument",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../public/audio-packs/**/*"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Tactile Quran Recitation Instrument",
        "width": 540,
        "height": 760,
        "resizable": true,
        "backgroundColor": "#0B0D10"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$APPDATA/**", "$RESOURCE/**"]
      }
    }
  }
}
